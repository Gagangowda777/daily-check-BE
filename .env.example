# Copy to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/dailycheck?retryWrites=true&w=majority
MONGODB_DB=dailycheck
API_PORT=4000

# Signs the session tokens issued at sign-in. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# Demo sign-in password (shown on the login screen).
DEMO_PASSWORD=demo1234

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Cloudinary account that stores the day snapshots taken before the Excel data
# is purged. Without these three values nothing is deleted.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# How many days the Excel-fed rows are kept before they are archived and
# deleted. Defaults to 30.
RETENTION_DAYS=30
